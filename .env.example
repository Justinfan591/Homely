# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# At least 32 random characters
SESSION_SECRET=
# Optional: where the demo providers and "Demo house" are seeded (default: Montreal).
# Change and re-run `npm run db:seed` to move the demo to the venue.
DEMO_LAT=
DEMO_LNG=
# Optional: 0 = ignore distance when matching, so every provider of the trade gets the job wherever the home is. Default on.
MATCH_BY_LOCATION=
# Optional: 1 = fake AI (instant, free, predictable) for UI work and tests. Or run `npm run dev:fake`.
SCOPE_FAKE_AI=
# Optional: comma-separated origins allowed to call /api (default: any origin).
CORS_ORIGINS=
# Optional: Google Calendar for /pro (OAuth client from Google Cloud Console; see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: OpenAI key for transcribing the app's voice screen (gpt-4o-mini-transcribe).
OPENAI_API_KEY=
# Optional: the sign-in code the app accepts for every phone or email (demo: nothing is sent). Default 7246.
DEMO_LOGIN_CODE=
